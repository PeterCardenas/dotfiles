{
  "quietStartup": true,
  "packages": [
    "npm:pi-web-access",
    "npm:pi-subagents"
  ],
  "extensions": ["~/.pi/agent/extensions/claude-compat.ts"],
  "subagents": {
    "defaultModel": "gpt-5.6-luna",
    "defaultThinking": "xhigh",
    "agentScanDirs": ["~/.claude/agents"],
    "agentOverrides": {"reviewer": {"model": "gpt-5.6-sol", "thinking": "medium"}}
  }
}
