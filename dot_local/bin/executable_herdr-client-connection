#!/usr/bin/env python3
"""Print the SSH_CONNECTION of the Herdr client the user is actively driving.

Herdr's server outlives every client, so pane shells cannot inherit a client's
environment, and several clients can be attached at once (for example a local
terminal plus an SSH attach). "Am I in an SSH session?" is therefore only
answerable per client, not per host: recording the value once at launch goes
stale as soon as another client attaches.

The client whose input was read most recently is the one receiving keystrokes:
a local client's controlling tty, or the stdin pipe of an SSH remote-client-bridge.
Herdr keeps redrawing clients, which bumps input mtime above atime and keeps
relatime updating atime on the next read.
"""

import os
import re
import shlex
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

DEFAULT_SESSION = "default"
CLIENT_COMMAND = "herdr"


class ClientDetectionUnavailable(RuntimeError):
    """The active client cannot be determined safely on this platform."""


@dataclass(frozen=True)
class HerdrClient:
    """An attached Herdr client process."""

    pid: int
    session: str
    ssh_connection: str | None
    last_input: float


def _read_null_separated(path: Path) -> list[str]:
    """Read a NUL-separated /proc file, returning an empty list if it is gone."""
    try:
        raw = path.read_bytes()
    except OSError:
        return []
    return [field for field in raw.decode(errors="replace").split("\0") if field]


def _parse_session(args: list[str]) -> str | None:
    """Return the session an attach invocation targets, or None if it is not one.

    Both attach spellings count: `herdr [--session <name>]` and the explicit
    `herdr session attach <name>`. A remote attach runs
    `herdr [--session <name>] remote-client-bridge` on this host; the
    `herdr --remote` process itself runs on the other host.
    Other positionals are CLI subcommands, not attached clients.
    """
    if args[:2] == ["session", "attach"]:
        return args[2] if len(args) == 3 else None

    session = DEFAULT_SESSION
    index = 0
    while index < len(args):
        argument = args[index]
        if argument == "--session" and index + 1 < len(args):
            session = args[index + 1]
            index += 2
        elif argument.startswith("--remote"):
            return None
        elif argument == "remote-client-bridge" and args[index + 1 :] in (
            [],
            ["--idle-timeout-v1"],
        ):
            return session
        elif argument.startswith("-"):
            index += 1
        else:
            return None
    return session


def _environment(proc_entry: Path) -> dict[str, str]:
    """Read a process environment as a mapping."""
    environment: dict[str, str] = {}
    for field in _read_null_separated(proc_entry / "environ"):
        name, separator, value = field.partition("=")
        if separator:
            environment[name] = value
    return environment


def _last_input(proc_entry: Path, remote_bridge: bool = False) -> float | None:
    """Return the atime of the client's input tty or remote bridge pipe."""
    if remote_bridge:
        # Remote attach has no controlling tty on the server; SSH feeds stdin
        # through a pipe whose atime advances as the bridge reads input.
        try:
            return (proc_entry / "fd" / "0").stat().st_atime
        except OSError:
            return None
    for descriptor in ("0", "1", "2"):
        try:
            tty = os.readlink(proc_entry / "fd" / descriptor)
        except OSError:
            continue
        if not tty.startswith("/dev/"):
            continue
        try:
            return os.stat(tty).st_atime
        except OSError:
            continue
    return None


def attached_clients(proc_root: Path = Path("/proc")) -> list[HerdrClient]:
    """Collect every attached Herdr client process."""
    clients: list[HerdrClient] = []
    for proc_entry in proc_root.iterdir():
        if not proc_entry.name.isdigit():
            continue
        args = _read_null_separated(proc_entry / "cmdline")
        if not args or os.path.basename(args[0]) != CLIENT_COMMAND:
            continue
        session = _parse_session(args[1:])
        if session is None:
            continue
        environment = _environment(proc_entry)
        # A `herdr` run from inside a pane is a CLI call, not an attached client.
        if "HERDR_ENV" in environment:
            continue
        last_input = _last_input(proc_entry, "remote-client-bridge" in args[1:])
        if last_input is None:
            continue
        clients.append(
            HerdrClient(
                pid=int(proc_entry.name),
                session=session,
                ssh_connection=environment.get("SSH_CONNECTION") or None,
                last_input=last_input,
            )
        )
    return clients


def _mac_ps(*args: str) -> str:
    result = subprocess.run(["ps", *args], capture_output=True, text=True, check=False)
    if result.returncode != 0:
        raise ClientDetectionUnavailable(result.stderr.strip() or "ps failed")
    return result.stdout


def _mac_processes() -> list[tuple[int, str, str]]:
    processes = []
    for line in _mac_ps("-axo", "pid=,tty=,comm=").splitlines():
        fields = line.split(maxsplit=2)
        if len(fields) == 3 and fields[0].isdigit():
            processes.append((int(fields[0]), fields[1], fields[2]))
    return processes


def _mac_command(pid: int) -> str:
    return _mac_ps("-p", str(pid), "-ww", "-o", "command=").strip()


def _mac_environment(pid: int) -> dict[str, str]:
    # ps -E exposes the environment captured at process launch, like /proc/environ.
    command_and_environment = _mac_ps("-E", "-p", str(pid), "-ww", "-o", "command=")
    environment = {}
    herdr_env = re.search(r"(?:^|\s)HERDR_ENV=(\S+)", command_and_environment)
    ssh_connection = re.search(r"(?:^|\s)SSH_CONNECTION=(\S+(?: \S+){3})", command_and_environment)
    if herdr_env:
        environment["HERDR_ENV"] = herdr_env.group(1)
    if ssh_connection:
        environment["SSH_CONNECTION"] = ssh_connection.group(1)
    return environment


def attached_clients_mac(target_session: str | None = None) -> list[HerdrClient]:
    """Find tty clients; a sole remote bridge needs no input-time comparison."""
    clients: list[HerdrClient] = []
    bridges: list[HerdrClient] = []
    for pid, tty, command in _mac_processes():
        if os.path.basename(command) != CLIENT_COMMAND:
            continue
        try:
            args = shlex.split(_mac_command(pid))
            if not args or os.path.basename(args[0]) != CLIENT_COMMAND:
                continue
            session = _parse_session(args[1:])
            if session is None or (target_session is not None and session != target_session):
                continue
            environment = _mac_environment(pid)
            if "HERDR_ENV" in environment:
                continue
            if "remote-client-bridge" in args[1:]:
                if not environment.get("SSH_CONNECTION"):
                    raise ClientDetectionUnavailable("remote bridge SSH origin is unavailable")
                bridges.append(HerdrClient(pid, session, environment["SSH_CONNECTION"], 0))
                continue
            if tty == "??" or tty == "?":
                raise ClientDetectionUnavailable("attached client has no readable tty")
            last_input = os.stat("/dev/" + tty.removeprefix("/dev/")).st_atime
        except ClientDetectionUnavailable:
            raise
        except (OSError, ValueError):
            # A client exiting during enumeration is not an active candidate.
            continue
        clients.append(HerdrClient(pid, session, environment.get("SSH_CONNECTION"), last_input))
    if bridges:
        if clients or len(bridges) != 1:
            raise ClientDetectionUnavailable("macOS cannot compare remote bridge input with other clients")
        return bridges
    return clients


def active_client(clients: list[HerdrClient], session: str) -> HerdrClient | None:
    """Return the most recently used client attached to the given session."""
    candidates = [client for client in clients if client.session == session]
    if not candidates:
        return None
    return max(candidates, key=lambda client: client.last_input)


def current_session(socket_path: str | None) -> str:
    """Derive the session name from the socket path Herdr exported to the pane.

    The default session lives at `<config>/herdr.sock`; a named session lives at
    `<config>/sessions/<name>/herdr.sock`, so the name is the directory, never
    the socket file.
    """
    if not socket_path:
        return DEFAULT_SESSION
    directory = Path(socket_path).parent
    if directory.parent.name == "sessions":
        return directory.name
    return DEFAULT_SESSION


def main() -> None:
    """Entry point for herdr-client-connection."""
    session = current_session(os.environ.get("HERDR_SOCKET_PATH"))
    try:
        clients = attached_clients_mac(session) if sys.platform == "darwin" else attached_clients()
        client = active_client(clients, session)
    except ClientDetectionUnavailable as error:
        print(f"herdr-client-connection: {error}", file=sys.stderr)
        sys.exit(1)
    if client and client.ssh_connection:
        sys.stdout.write(client.ssh_connection)


if __name__ == "__main__":
    main()
