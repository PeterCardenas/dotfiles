#!/usr/bin/env fish

set -l tmux_passthrough 0
if set -q TMUX; and not test "$HERDR_ENV" = 1
    set tmux_passthrough 1
end

set -l pty
if test "$tmux_passthrough" = 1
    set pty (tmux display -p '#{pane_tty}')
else
    set pty (tty)
end

# not too sure if this will always work, but rn it does
if test "$pty" = "not a tty"
    set pty /dev/tty
end

set -l piped_content
if not isatty stdin
    read -z piped_content
end

set -l contents (string join \n $argv | string collect)
if test -n "$piped_content"
    set contents "$piped_content$contents"
end
# Unescape backticks that callers (e.g. lazygit via sh -c) may have escaped
set contents (string replace -a "\\`" "`" "$contents" | string collect)
set -l osc_prefix
if test "$tmux_passthrough" = 1
    if set -q SSH_CONNECTION
        set osc_prefix "\x1bPtmux;\x1b\x1bPtmux;\x1b\x1b\x1b\x1b"
    else
        set osc_prefix "\x1bPtmux;\x1b\x1b"
    end
else
    set osc_prefix "\x1b"
end
set -l osc_suffix
if test "$tmux_passthrough" = 1
    if set -q SSH_CONNECTION
        set osc_suffix '\a\x1b\x1b\\\\\x1b\\'
    else
        set osc_suffix '\a\x1b\\'
    end
else
    set osc_suffix '\x1b\\'
end
set -l serialized_contents (printf '%s' "$contents" | base64 | tr -d '\r\n')
echo -ne "$osc_prefix]52;c;$serialized_contents$osc_suffix" >$pty
