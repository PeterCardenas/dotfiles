#!/usr/bin/env bash

set -euo pipefail

direction="${1:?usage: herdr-navigate <left|down|up|right>}"
herdr="${HERDR_BIN_PATH:-herdr}"
pane="${HERDR_PANE_ID:-${HERDR_ACTIVE_PANE_ID:-}}"

case "$direction" in
  left) key="ctrl+h" ;;
  down) key="ctrl+j" ;;
  up) key="ctrl+k" ;;
  right) key="ctrl+l" ;;
  *) echo "herdr-navigate: unknown direction: $direction" >&2; exit 2 ;;
esac

vim_re='^g?(view|l?n?vim?x?)(diff)?$'
passthrough_re="${HERDR_NAV_PASSTHROUGH_RE:-}"
forward=0

if [ "${2:-}" != "--force" ] && [ -n "$pane" ] && command -v jq >/dev/null 2>&1; then
  if "$herdr" pane process-info --pane "$pane" 2>/dev/null \
    | jq -e --arg vim "$vim_re" --arg pass "$passthrough_re" \
      '.result.process_info.foreground_processes[]?.name
       | ascii_downcase
       | select(test($vim) or ($pass != "" and (try test($pass) catch false)))' >/dev/null 2>&1; then
    forward=1
  fi
fi

if [ "$forward" -eq 1 ]; then
  exec "$herdr" pane send-keys "$pane" "$key"
fi

if [ -n "$pane" ]; then
  "$herdr" pane zoom --off --pane "$pane"
  if command -v jq >/dev/null 2>&1; then
    if neighbor=$("$herdr" pane neighbor --direction "$direction" --pane "$pane" 2>/dev/null | jq -r '.result.neighbor.neighbor_pane_id // empty'); then
      if [ -z "$neighbor" ]; then
        case "$direction" in
          left) opposite=right ;;
          right) opposite=left ;;
          up) opposite=down ;;
          down) opposite=up ;;
        esac
        # Walk the opposite edge without moving focus; focus only the final pane.
        previous="$pane"
        while :; do
          neighbor=$("$herdr" pane neighbor --direction "$opposite" --pane "$previous" | jq -r '.result.neighbor.neighbor_pane_id // empty')
          [ -n "$neighbor" ] || break
          before_last="$previous"
          previous="$neighbor"
        done
        if [ "$previous" != "$pane" ]; then
          exec "$herdr" pane focus --direction "$opposite" --pane "$before_last"
        fi
      fi
    fi
  fi
  exec "$herdr" pane focus --direction "$direction" --pane "$pane"
fi

"$herdr" pane zoom --off --current
exec "$herdr" pane focus --direction "$direction" --current
